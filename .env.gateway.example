# ========================================
# GatewayWorker 配置
# ========================================

# Register 服务地址（内网地址）
# 单个地址格式：IP:端口
GATEWAY_REGISTER_ADDRESS=192.168.1.100:1236

# 多个地址格式（高可用，用逗号分隔）
# GATEWAY_REGISTER_ADDRESS=192.168.1.100:1236,192.168.1.101:1236

# 本地开发环境（默认）
# GATEWAY_REGISTER_ADDRESS=127.0.0.1:1236
